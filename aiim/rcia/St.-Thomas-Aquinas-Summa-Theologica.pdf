ITION \(TWO ARTICLES\))>>endobj18650 0 obj<</Parent 18649 0 R/Next 18651 0 R/Dest(SS.Q92.A1)/Title(Article. 1 - Whether superstition is a vice contrary to religion?)>>endobj18651 0 obj<</Parent 18649 0 R/Dest(SS.Q92.A2)/Prev 18650 0 R/Title(Article. 2 - Whether there are various species of superstition?)>>endobj18652 0 obj<</First 18653 0 R/Parent 18557 0 R/Next 18649 0 R/Dest(SS.Q91)/Count -2/Last 18654 0 R/Prev 18655 0 R/Title(Question. 91 - OF TAKING THE DIVINE NAME FOR THE PURPOSE OF INVOKING IT BY MEANS OF PRAISE \(TWO ARTICLES\))>>endobj18653 0 obj<</Parent 18652 0 R/Next 18654 0 R/Dest(SS.Q91.A1)/Title(Article. 1 - Whether God should be praised with the lips?)>>endobj18654 0 obj<</Parent 18652 0 R/Dest(SS.Q91.A2)/Prev 18653 0 R/Title(Article. 2 - Whether God should be praised with song?)>>endobj18655 0 obj<</First 18656 0 R/Parent 18557 0 R/Next 18652 0 R/Dest(SS.Q90)/Count -3/Last 18657 0 R/Prev 18658 0 R/Title(Question. 90 - OF THE TAKING OF GOD'S NAME BY WAY OF ADJURATION \(THREE ARTICLES\))>>endobj18656 0 obj<</Parent 18655 0 R/Next 18916 0 R/Dest(SS.Q90.A1)/Title(Article. 1 - Whether it is lawful to adjure a man?)>>endobj18657 0 obj<</Parent 18655 0 R/Dest(SS.Q90.A3)/Prev 18916 0 R/Title(Article. 3 - Whether it is lawful to adjure an irrational creature?)>>endobj18658 0 obj<</First 18659 0 R/Parent 18557 0 R/Next 18655 0 R/Dest(SS.Q89)/Count -10/Last 18660 0 R/Prev 18661 0 R/Title(Question. 89 - OF OATHS \(TEN ARTICLES\))>>endobj18659 0 obj<</Parent 18658 0 R/Next 18915 0 R/Dest(SS.Q89.A1)/Title(Article. 1 - Whether to swear is to call God to witness?)>>endobj18660 0 obj<</Parent 18658 0 R/Dest(SS.Q89.A10)/Prev 18908 0 R/Title(Article. 10 - Whether an oath is voided by a condition of person or time?)>>endobj18661 0 obj<</First 18662 0 R/Parent 18557 0 R/Next 18658 0 R/Dest(SS.Q88)/Count -12/Last 18663 0 R/Prev 18664 0 R/Title(Question. 88 - SERVICE BY PROMISE \(Q[88]\))>>endobj18662 0 obj<</Parent 18661 0 R/Next 18907 0 R/Dest(S